<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
{{if not (or .Expired .RetryIn)}}<meta http-equiv="refresh" content="5;url=/pair?auto=1">{{end}}
<title>Pair WhatsApp</title>
{{template "styles"}}
</head><body>
<main class="card">
{{template "brand"}}
<h1>Pair WhatsApp</h1>
{{if or .Expired .RetryIn}}
<p class="lead"><b>The pairing session expired.</b> WhatsApp closes an unused pairing session after a few minutes.</p>
{{if .RetryIn}}<p class="lead">A new session can start in {{.RetryIn}} seconds: reload this page then.</p>{{else}}<p><a class="btn" href="/pair">Start a new pairing session</a></p>{{end}}
{{else}}
<p class="lead">Link this daemon to your account in a few seconds.</p>

<div class="qr-wrap">
  <img src="/pair/qr.png" alt="WhatsApp pairing QR" width="248" height="248">
  <span class="corner c1"></span><span class="corner c2"></span><span class="corner c3"></span><span class="corner c4"></span>
  <span class="scan" aria-hidden="true"></span>
</div>
<div class="live"><span class="dot"></span>Waiting for scan · QR refreshes automatically</div>
<div class="bar" aria-hidden="true"><i></i></div>

<ol class="steps">
  <li><span>Open <b>WhatsApp</b> on your phone</span></li>
  <li><span>Go to <b>Settings</b> → <b>Linked Devices</b></span></li>
  <li><span>Tap <b>Link a Device</b> and point the camera at the code</span></li>
</ol>
{{end}}

<details{{if or .Expired .RetryIn}} open{{end}}>
  <summary>Can't scan? Pair with your phone number</summary>
  <p>Enter your number with the country code, then type the code into WhatsApp via <b>Link with phone number instead</b>.</p>
  <form class="row" method="post" action="/pair/code">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <input type="text" name="phone" placeholder="+33 6 12 34 56 78" inputmode="tel" autocomplete="tel" required>
    <button type="submit">Get code</button>
  </form>
</details>
</main>
</body></html>
