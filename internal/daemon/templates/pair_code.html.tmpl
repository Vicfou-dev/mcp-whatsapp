<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<title>WhatsApp pairing code</title>
{{template "styles"}}
</head><body>
<main class="card">
{{template "brand"}}
<h1>Pair with phone number</h1>
{{if .Code}}
<p class="lead">On your phone, open <b>Settings</b> → <b>Linked Devices</b> → <b>Link a Device</b> → <b>Link with phone number instead</b>, then enter:</p>
<div class="code">{{.Code}}</div>
<a class="btn" href="/pair">Done</a>
<p class="note">The code expires shortly. Request a new one if it lapses. This page does not auto-refresh.</p>
{{else}}
<p class="lead err">{{.Message}}</p>
<a class="btn" href="/pair">Back to QR pairing</a>
{{end}}
</main>
</body></html>
